#!/bin/bash
# -----------------------------------------------------------------------------
# Storefront web instance bootstrap (rendered by Terraform templatefile).
# App bundle version: ${app_md5}
# Output is written to /var/log/storefront-bootstrap.log and shipped to
# CloudWatch Logs (${log_group_prefix}/user-data).
# -----------------------------------------------------------------------------
set -euo pipefail
exec > >(tee -a /var/log/storefront-bootstrap.log) 2>&1

REGION="${region}"
APP_DIR=/opt/storefront
CONF_DIR=/etc/storefront
LOG_DIR=/var/log/storefront

echo "[bootstrap] start $(date -Is)"

# ---- 1. Packages -------------------------------------------------------------
dnf install -y nginx python3-pip unzip amazon-cloudwatch-agent

# ---- 2. CloudWatch agent first, so the rest of the bootstrap is visible -------
mkdir -p $LOG_DIR
cat > /opt/aws/amazon-cloudwatch-agent/etc/storefront.json <<'CWCONFIG'
{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "metrics": {
    "namespace": "${cloudwatch_ns}",
    "append_dimensions": {
      "AutoScalingGroupName": "$${aws:AutoScalingGroupName}",
      "InstanceId": "$${aws:InstanceId}"
    },
    "aggregation_dimensions": [["AutoScalingGroupName"]],
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/nginx/access.log",          "log_group_name": "${log_group_prefix}/nginx-access", "log_stream_name": "{instance_id}" },
          { "file_path": "/var/log/nginx/error.log",           "log_group_name": "${log_group_prefix}/nginx-error",  "log_stream_name": "{instance_id}" },
          { "file_path": "/var/log/storefront/*.log",          "log_group_name": "${log_group_prefix}/storefront",   "log_stream_name": "{instance_id}" },
          { "file_path": "/var/log/storefront-bootstrap.log",  "log_group_name": "${log_group_prefix}/user-data",    "log_stream_name": "{instance_id}" }
        ]
      }
    }
  }
}
CWCONFIG
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/storefront.json

# ---- 3. Application code ------------------------------------------------------
mkdir -p $APP_DIR $CONF_DIR
aws s3 cp "s3://${artifact_bucket}/${app_key}" /tmp/storefront.zip --region "$REGION"
unzip -o -q /tmp/storefront.zip -d $APP_DIR
rm -f /tmp/storefront.zip

python3 -m venv $APP_DIR/venv
$APP_DIR/venv/bin/pip install --quiet --upgrade pip
$APP_DIR/venv/bin/pip install --quiet -r $APP_DIR/requirements.txt

# RDS certificate bundle so the app can verify the database TLS certificate.
curl -fsSL --retry 5 -o $CONF_DIR/rds-ca.pem "https://truststore.pki.rds.amazonaws.com/$REGION/$REGION-bundle.pem"

# ---- 4. Runtime configuration (no secrets in here, only secret ARNs) ---------
cat > $CONF_DIR/config.json <<APPCONFIG
{
  "region": "${region}",
  "stack_name": "${name}",
  "app_version": "${app_md5}",
  "db_writer_host": "${db_writer_host}",
  "db_reader_host": "${db_reader_host}",
  "db_name": "${db_name}",
  "db_secret_arn": "${db_secret_arn}",
  "db_ca_path": "$CONF_DIR/rds-ca.pem",
  "redis_host": "${redis_host}",
  "redis_secret_arn": "${redis_secret_arn}",
  "cache_ttl_seconds": 60
}
APPCONFIG

useradd --system --home-dir $APP_DIR --shell /sbin/nologin storefront 2>/dev/null || true
chown -R storefront:storefront $APP_DIR $LOG_DIR
chown root:storefront $CONF_DIR/config.json $CONF_DIR/rds-ca.pem
chmod 0640 $CONF_DIR/config.json
chmod 0644 $CONF_DIR/rds-ca.pem

# ---- 5. Schema and seed data (idempotent, safe on every instance) ------------
for attempt in $(seq 1 30); do
  if sudo -u storefront $APP_DIR/venv/bin/python $APP_DIR/manage.py init-db; then
    echo "[bootstrap] database ready"
    break
  fi
  echo "[bootstrap] database not ready (attempt $attempt), retrying in 10s"
  sleep 10
done

# ---- 6. gunicorn service ------------------------------------------------------
cat > /etc/systemd/system/storefront.service <<'UNIT'
[Unit]
Description=Storefront (gunicorn + Flask)
After=network-online.target
Wants=network-online.target

[Service]
User=storefront
Group=storefront
WorkingDirectory=/opt/storefront
ExecStart=/opt/storefront/venv/bin/gunicorn app:app \
  --workers 3 --bind 127.0.0.1:8000 --timeout 30 \
  --access-logfile /var/log/storefront/gunicorn-access.log \
  --error-logfile /var/log/storefront/gunicorn-error.log
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
UNIT

# ---- 7. nginx reverse proxy ---------------------------------------------------
cat > /etc/nginx/conf.d/storefront.conf <<'NGINX'
server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    client_max_body_size 1m;

    location = /health {
        access_log off;
        proxy_pass http://127.0.0.1:8000/health;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
NGINX

systemctl daemon-reload
systemctl enable --now storefront
nginx -t
systemctl enable --now nginx

echo "[bootstrap] complete $(date -Is)"
