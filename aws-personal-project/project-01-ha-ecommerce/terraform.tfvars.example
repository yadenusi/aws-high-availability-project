# Copy to terraform.tfvars (git ignored) and edit.
#   cp terraform.tfvars.example terraform.tfvars

alert_email = "you@example.com"

project_name = "ecommerce-ha"
environment  = "dev"
owner        = "Yusuf Adenusi"
aws_region   = "us-east-2"

# Network
vpc_cidr           = "10.10.0.0/16"
az_count           = 2
single_nat_gateway = false # true saves about $1 per day but removes NAT redundancy

# Web tier
instance_type        = "t3.micro"
asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 6
cpu_target_percent   = 50
requests_per_target  = 1000

# Database
db_instance_class        = "db.t3.micro"
db_backup_retention_days = 7

# Cache
redis_node_type          = "cache.t3.micro"
redis_num_cache_clusters = 2

# Optional HTTPS between CloudFront and the ALB (needs a domain you own)
# alb_certificate_arn = "arn:aws:acm:us-east-2:123456789012:certificate/..."
# origin_domain_name  = "origin.example.com"

# Lab lifecycle (keep these for easy teardown)
force_destroy_buckets       = true
secret_recovery_window_days = 0
alb_deletion_protection     = false
db_deletion_protection      = false
db_skip_final_snapshot      = true

enable_fis = true
